{
  "name": "sentinel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node scripts/gen-api-registry.mjs --check && next build",
    "vercel-build": "sh scripts/vercel-build.sh",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "NEXT_DIST_DIR=.next-e2e next build && playwright test",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force --skip-seed",
    "seed": "prisma migrate reset --force --skip-seed && tsx prisma/seed.ts",
    "seed:only": "tsx prisma/seed.ts",
    "simulate": "tsx jobs/simulate-transactions.ts",
    "worker": "tsx jobs/worker.ts",
    "demo:advance-day": "tsx jobs/advance-day.ts",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "seed:template": "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sentinel_tpl?schema=public sh -c \"prisma migrate deploy && tsx prisma/seed.ts\"",
    "postinstall": "prisma generate",
    "mock:build": "node scripts/build-mock-db.mjs",
    "dev:mock": "SENTINEL_MOCK=1 next dev",
    "test:demo": "SENTINEL_MOCK=1 NEXT_DIST_DIR=.next-demo next build && playwright test -c playwright.demo.config.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@electric-sql/pglite-socket": "^0.2.15",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "geist": "^1.8.2",
    "lucide-react": "^0.540.0",
    "next": "^15.5.28",
    "next-auth": "^5.0.0-beta.32",
    "pg-boss": "^10.4.2",
    "pino": "^9.7.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^2.15.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
